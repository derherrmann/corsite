---
import LanguageSwitch from './LanguageSwitch.astro';
import {
  navigationLabels,
  navigationPages,
  navigationUi,
  pageRoutes,
  type Locale,
  type PageKey,
} from '../../i18n/navigation';

interface Props {
  lang: Locale;
  page: PageKey;
}

const { lang, page } = Astro.props;
const ui = navigationUi[lang];
---

<div class="navigation-shell">
  <a
    class="brand"
    href={pageRoutes.home[lang]}
    aria-current={page === 'home' ? 'page' : undefined}
  >
    <span class="brand-name">Corinne</span>
    <span class="brand-line">Free in Flow</span>
  </a>

  <nav class="desktop-links" aria-label={ui.primaryLabel}>
    {navigationPages.map((item) => (
      <a
        href={pageRoutes[item][lang]}
        aria-current={page === item ? 'page' : undefined}
      >{navigationLabels[lang][item]}</a>
    ))}
  </nav>

  <div class="desktop-language">
    <LanguageSwitch lang={lang} page={page} />
  </div>

  <details class="mobile-menu">
    <summary>
      <span>{ui.menuLabel}</span>
      <span class="menu-mark" aria-hidden="true">+</span>
    </summary>
    <div class="mobile-panel">
      <nav class="mobile-links" aria-label={ui.primaryLabel}>
        {navigationPages.map((item) => (
          <a
            href={pageRoutes[item][lang]}
            aria-current={page === item ? 'page' : undefined}
          >{navigationLabels[lang][item]}</a>
        ))}
      </nav>
      <LanguageSwitch lang={lang} page={page} />
    </div>
  </details>
</div>

<style>
  .navigation-shell {
    position: relative;
  }

  .brand {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 2.75rem;
    color: var(--color-text);
    line-height: 1.12;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--color-primary-hover);
  }

  .brand-name {
    font-size: 1.125rem;
    font-weight: 650;
    letter-spacing: -0.025em;
  }

  .brand-line {
    margin-top: 0.15rem;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.075em;
  }

  .desktop-links,
  .desktop-language {
    display: none;
  }

  .mobile-menu {
    display: block;
  }

  .mobile-menu summary {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 4.75rem;
    min-height: 2.75rem;
    color: var(--color-text);
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 600;
    list-style: none;
  }

  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }

  .mobile-menu summary:hover,
  .mobile-menu[open] summary {
    color: var(--color-primary-hover);
  }

  .menu-mark {
    font-size: 1.5rem;
    font-weight: 400;
    line-height: 1;
  }

  .mobile-menu[open] .menu-mark {
    transform: rotate(45deg);
  }

  .mobile-panel {
    padding-block: var(--space-4) var(--space-3);
  }

  .mobile-links {
    display: grid;
    gap: var(--space-1);
  }

  .mobile-links a {
    display: flex;
    align-items: center;
    min-height: 3.5rem;
    color: var(--color-text);
    font-size: clamp(1.5rem, 5vw, 2.25rem);
    text-decoration: none;
  }

  .mobile-links a:hover,
  .mobile-links a[aria-current='page'] {
    color: var(--color-primary-hover);
  }

  .mobile-links a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25em;
  }

  .mobile-panel :global(.language-switch) {
    margin-top: var(--space-4);
  }

  @media (min-width: 68rem) {
    .navigation-shell {
      display: grid;
      grid-template-columns: minmax(8rem, 1fr) auto auto;
      align-items: center;
      gap: var(--space-2);
    }

    .desktop-links {
      display: flex;
      align-items: center;
      gap: clamp(0.75rem, 1.4vw, 1.5rem);
    }

    .desktop-links a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.75rem;
      color: var(--color-text);
      font-size: var(--text-sm);
      text-decoration: none;
      white-space: nowrap;
    }

    .desktop-links a:hover,
    .desktop-links a[aria-current='page'] {
      color: var(--color-primary-hover);
    }

    .desktop-links a[aria-current='page'] {
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.5em;
    }

    .desktop-language {
      display: flex;
      justify-content: flex-end;
      margin-inline-start: var(--space-3);
    }

    .mobile-menu {
      display: none;
    }
  }
</style>
