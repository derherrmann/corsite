---
import { Image } from 'astro:assets';
import pathPhoto from '../../assets/images/nature/entlang-dem-inn.jpg';
import type { Locale } from '../../i18n/navigation';

interface Props {
  heading: string;
  lang: Locale;
}

const { heading, lang } = Astro.props;
const imageAlt = lang === 'de'
  ? 'Weg durch den alpinen Wald mit Bergen im Oberengadin'
  : 'Path through an alpine forest with mountains in the Upper Engadin';
---

<section class="home-hero" aria-labelledby="home-heading">
  <div class="hero-intro">
    <h1 id="home-heading">{heading}</h1>
    <p>Free in Flow</p>
  </div>
  <div class="hero-media">
    <Image
      src={pathPhoto}
      alt={imageAlt}
      width={1920}
      height={1440}
      widths={[480, 720, 960, 1440, 1920, 2400]}
      sizes="(min-width: 76rem) 72rem, calc(100vw - 2rem)"
      quality={80}
      priority
      class="hero-image"
    />
  </div>
</section>

<style>
  .hero-intro {
    display: grid;
    gap: var(--space-2);
    padding-block-end: var(--space-4);
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: var(--text-display-hero);
  }

  p {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .hero-media {
    height: max(72svh, 25rem);
    overflow: hidden;
  }

  .hero-media :global(.hero-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% 60%;
  }

  @media (min-width: 48rem) {
    .hero-intro {
      grid-template-columns: minmax(0, 2fr) minmax(10rem, 1fr);
      align-items: end;
      gap: var(--space-4);
      padding-block-end: var(--space-5);
    }

    .hero-intro p {
      justify-self: end;
      padding-block-end: 0.35em;
    }

    .hero-media {
      height: clamp(48rem, 82svh, 60rem);
    }
  }
</style>
